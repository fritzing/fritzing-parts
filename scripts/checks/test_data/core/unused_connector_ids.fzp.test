<?xml version='1.0' encoding='UTF-8'?>
<module moduleId="test_unused_connector_ids">
  <version>1</version>
  <views>
    <pcbView>
      <layers image="pcb/unused_connector_ids_pcb.svg">
        <layer layerId="copper0"/>
        <layer layerId="copper1"/>
      </layers>
    </pcbView>
    <breadboardView>
      <layers image="breadboard/unused_connector_ids_breadboard.svg">
        <layer layerId="breadboard"/>
      </layers>
    </breadboardView>
    <schematicView>
      <layers image="schematic/unused_connector_ids_schematic.svg">
        <layer layerId="schematic"/>
      </layers>
    </schematicView>
  </views>
  <connectors>
    <connector id="connector0" type="male">
      <views>
        <pcbView>
          <p svgId="connector0pad" layer="copper0"/>
          <p svgId="connector0pad" layer="copper1"/>
        </pcbView>
        <breadboardView>
          <p svgId="connector0pin" layer="breadboard"/>
        </breadboardView>
        <schematicView>
          <p svgId="connector0pin" terminalId="connector0terminal" layer="schematic"/>
        </schematicView>
      </views>
    </connector>
  </connectors>
</module>
